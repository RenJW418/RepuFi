{
  "name": "repufi-ledger",
  "version": "0.1.0",
  "private": true,
  "description": "PACT Ledger module: on-chain commitment market and credibility SBT",
  "scripts": {
    "node": "hardhat node",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network testnet",
    "demo": "tsx scripts/seedDemo.ts",
    "demo:scenarios": "hardhat run scripts/demoScenarios.ts",
    "seed:plaza": "hardhat run scripts/seedPlaza.ts --network localhost",
    "seed:plaza:testnet": "hardhat run scripts/seedPlaza.ts --network testnet",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.0.2",
    "@types/node": "^20.14.10",
    "ethers": "^6.13.1",
    "hardhat": "^2.22.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
