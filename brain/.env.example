# Brain module environment variables
# Copy to .env.local and fill before running against a real testnet.

# Anthropic API key (optional — falls back to deterministic mock if absent)
ANTHROPIC_API_KEY=

# Anthropic API base URL override (e.g. mintapi.cn relay)
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Model override (default: claude-haiku-4-5-20251001)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# xAPI key as alternative LLM provider
XAPI_KEY=

# RPC URL for Sepolia (required for brain:smoke)
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Wallet private keys (testnet-only wallets with faucet ETH)
PRIVATE_KEY_SUBJECT=
PRIVATE_KEY_SKEPTIC=
PRIVATE_KEY_VERIFIER=

# Brain intake server host/port (defaults: 127.0.0.1:8790)
BRAIN_HOST=127.0.0.1
BRAIN_PORT=8790
