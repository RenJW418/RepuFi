{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "agents/**/*.ts",
    "llm/**/*.ts",
    "mocks/**/*.ts",
    "scripts/**/*.ts",
    "shared/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts"
  ]
}
