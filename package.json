{
  "name": "repufi-ledger",
  "version": "0.1.0",
  "private": true,
  "description": "PACT Ledger module: on-chain commitment market and credibility SBT",
  "scripts": {
    "brain:demo": "npm --prefix brain run demo --",
    "brain:smoke": "npm --prefix brain run repuFi:smoke",
    "brain:selfcheck": "npm --prefix brain run selfcheck",
    "brain:test": "npm --prefix brain test",
    "brain:typecheck": "npm --prefix brain run typecheck",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy": "hardhat run scripts/deploy.ts --network localhost",
    "demo": "tsx scripts/seedDemo.ts",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.0.2",
    "@types/node": "^20.14.10",
    "ethers": "^6.13.1",
    "hardhat": "^2.22.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
