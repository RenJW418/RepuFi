{
  "name": "repufi",
  "version": "0.1.0",
  "private": true,
  "description": "RepuFi monorepo with Ledger and Brain modules",
  "scripts": {
    "setup": "npm install --prefix ledger && npm install --prefix ledger/frontend && npm install --prefix brain",
    "node": "npm --prefix ledger run node",
    "compile": "npm --prefix ledger run compile",
    "test": "npm --prefix ledger test",
    "deploy": "npm --prefix ledger run deploy",
    "deploy:testnet": "npm --prefix ledger run deploy:testnet",
    "demo": "npm --prefix ledger run demo",
    "frontend:dev": "npm --prefix ledger run frontend:dev",
    "frontend:build": "npm --prefix ledger run frontend:build",
    "ledger:node": "npm --prefix ledger run node",
    "ledger:compile": "npm --prefix ledger run compile",
    "ledger:test": "npm --prefix ledger test",
    "ledger:deploy": "npm --prefix ledger run deploy",
    "ledger:demo": "npm --prefix ledger run demo",
    "ledger:demo:scenarios": "npm --prefix ledger run demo:scenarios",
    "ledger:seed:plaza": "npm --prefix ledger run seed:plaza",
    "ledger:seed:plaza:testnet": "npm --prefix ledger run seed:plaza:testnet",
    "ledger:frontend:dev": "npm --prefix ledger run frontend:dev",
    "ledger:frontend:build": "npm --prefix ledger run frontend:build",
    "brain:demo": "npm --prefix brain run demo --",
    "brain:intake": "npm --prefix brain run intake",
    "brain:smoke": "npm --prefix brain run repuFi:smoke",
    "brain:scenarios": "npm --prefix brain run scenarios",
    "brain:selfcheck": "npm --prefix brain run selfcheck",
    "brain:test": "npm --prefix brain test",
    "brain:typecheck": "npm --prefix brain run typecheck"
  }
}
