# Copy to .env.local and fill before deploying to a public testnet.

# EVM testnet RPC endpoint, for example a Sepolia/Holesky RPC URL.
REPUFI_TESTNET_RPC_URL=

# Numeric EVM chain id for the selected testnet.
REPUFI_TESTNET_CHAIN_ID=

# Deployment wallet private key. Use a fresh testnet-only wallet with faucet ETH.
REPUFI_TESTNET_PRIVATE_KEY=

# Optional role addresses. Leave empty to reuse the deployment wallet for testnet demos.
REPUFI_TESTNET_VERIFIER_ADDRESS=
REPUFI_TESTNET_REVIEWER_ADDRESS=
REPUFI_TESTNET_INSURANCE_TREASURY=
REPUFI_TESTNET_COMMUNITY_TREASURY=

# Frontend RPC override when serving a deployed testnet demo.
VITE_RPC_URL=

# Brain intake API location for the frontend.
VITE_BRAIN_API_URL=http://127.0.0.1:8790
